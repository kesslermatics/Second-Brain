# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Qdrant
QDRANT_URL=https://your-qdrant-instance.example.com
QDRANT_PORT=6333

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary reasoning and fast/high-volume models (OpenRouter model IDs)
PRIMARY_MODEL=google/gemini-3.8-flash
FAST_MODEL=google/gemini-2.5-flash-lite
# Keep the dimension in sync with the Qdrant collection. Changing either requires a full reindex.
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
JWT_SECRET=generate-a-random-secret-here

# CORS
FRONTEND_URLS=https://your-frontend-domain.com

# Backend
BACKEND_URL=https://your-backend-domain.com
