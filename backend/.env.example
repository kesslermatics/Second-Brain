# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Qdrant
QDRANT_URL=https://your-qdrant-instance.example.com
QDRANT_PORT=6333

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Primary reasoning and fast/high-volume models
OPENAI_PRIMARY_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-luna
# Keep the dimension in sync with the Qdrant collection. Changing either requires a full reindex.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
JWT_SECRET=generate-a-random-secret-here

# CORS
FRONTEND_URLS=https://your-frontend-domain.com

# Backend
BACKEND_URL=https://your-backend-domain.com
